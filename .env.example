# =============================================================
# benessere.digital — Environment Variables
# Copy this file to .env.local for local development.
# Never commit .env.local — it is in .gitignore.
# Never commit API keys or other secrets.
# =============================================================

# ---- Next.js ----------------------------------------------------
# Preview/local override. Production canonical host is https://www.benessere.digital
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---- Analytics (GA4) --------------------------------------------
# Stream: www.benessere.digital. Loaded only after cookie consent
# (localStorage benessere-cookie-consent=accept).
# Fallback in code if unset: G-SF9NZWHZFZ
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-SF9NZWHZFZ

# ---- Newsletter (Resend) ----------------------------------------
# Required to enable the form. GET /api/newsletter returns { enabled: Boolean(RESEND_API_KEY) }.
# Create a full-access key at https://resend.com/api-keys (contacts + segments).
# RESEND_API_KEY=re_xxxxxxxxx

# Segment "benessere.digital" (already created in Resend).
# If unset, the API falls back to this documented id.
# RESEND_SEGMENT_ID=0275e55f-100d-49be-8f47-cfa2452b1263

# Optional secondary notify after a successful Resend subscribe.
# POST JSON { email, source }. Failures are ignored (Resend is primary).
# NEWSLETTER_WEBHOOK_URL=https://hooks.example.com/newsletter

# ---- Environment ------------------------------------------------
NODE_ENV=development
