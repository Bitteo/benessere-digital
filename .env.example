# =============================================================
# benessere.digital — Environment Variables
# Copy this file to .env.local for local development.
# Never commit .env.local — it is in .gitignore.
# =============================================================

# ---- Database ---------------------------------------------------
# Local: postgresql://postgres:postgres@localhost:5432/benessere_digital
# Production: use Neon or Vercel Postgres connection string
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/benessere_digital

# ---- Payload CMS ------------------------------------------------
# Generate a strong random secret for production:
#   openssl rand -hex 32
PAYLOAD_SECRET=your-super-secret-payload-key-change-in-production

# ---- Next.js ----------------------------------------------------
# Set to your production domain in Vercel environment variables
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---- Vercel Blob (production only) ------------------------------
# Created automatically when you add Vercel Blob storage in the
# Vercel dashboard. Required for media uploads in production.
# BLOB_READ_WRITE_TOKEN=vercelblob_rw_...

# ---- Environment ------------------------------------------------
NODE_ENV=development
