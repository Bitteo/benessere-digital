# =============================================================
# benessere.digital — Environment Variables
# Copy this file to .env.local for local development.
# Never commit .env.local — it is in .gitignore.
# =============================================================

# ---- Next.js ----------------------------------------------------
# Preview/local override. Production canonical host is https://www.benessere.digital
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---- Analytics (GA4) --------------------------------------------
# Stream: www.benessere.digital. Loaded only after cookie consent
# (localStorage benessere-cookie-consent=accept).
# Fallback in code if unset: G-SF9NZWHZFZ
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-SF9NZWHZFZ

# ---- Newsletter -------------------------------------------------
# POST JSON { email, source } when a reader submits the form.
# Leave unset to disable the form (no fake "iscrizione confermata").
# NEWSLETTER_WEBHOOK_URL=https://hooks.example.com/newsletter

# ---- Environment ------------------------------------------------
NODE_ENV=development
